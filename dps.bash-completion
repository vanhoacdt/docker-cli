_dps_container_names() {
docker ps -a --format '{{.Names}}' 2>/dev/null | sort -f
}

_dps_image_repos() {
docker images --format '{{.Repository}}' 2>/dev/null | grep -v '^<none>$' | sort -u -f
}

_dps_completions() {
local cur prev first idx
cur="${COMP_WORDS[COMP_CWORD]}"
prev="${COMP_WORDS[COMP_CWORD-1]:-}"
first="${COMP_WORDS[1]:-}"
idx="${COMP_CWORD}"

local short_opts="-s -w -d -p -i -c -o -l -f -h"
local sort_opts="mem cpu run"

if [[ "$idx" -eq 1 ]]; then
if [[ -z "$cur" || "$cur" == -* ]]; then
  COMPREPLY=( $(compgen -W "$short_opts" -- "$cur") )
else
  COMPREPLY=( $(compgen -W "$(_dps_container_names)" -- "$cur") )
fi
return 0
fi

if [[ "$cur" == -* ]]; then
COMPREPLY=( $(compgen -W "$short_opts" -- "$cur") )
return 0
fi

case "$first" in
-l|--logs|-f|--follow|-c|--config|--inspect)
  if [[ "$idx" -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "$(_dps_container_names)" -- "$cur") )
  elif [[ "$idx" -eq 3 && ( "$first" == "-l" || "$first" == "--logs" || "$first" == "-f" || "$first" == "--follow" ) ]]; then
    COMPREPLY=( $(compgen -W "20 40 100 200" -- "$cur") )
  else
    COMPREPLY=()
  fi
  return 0
  ;;
-i|--images)
  if [[ "$idx" -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "$(_dps_image_repos)" -- "$cur") )
  else
    COMPREPLY=()
  fi
  return 0
  ;;
-s|--stats|-w|--watch)
  if [[ "$idx" -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "$sort_opts $(_dps_container_names)" -- "$cur") )
  else
    COMPREPLY=()
  fi
  return 0
  ;;
esac

COMPREPLY=()
}

complete -F _dps_completions dps
